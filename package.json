{
  "name": "hackathon-app",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "check": "pnpm -r run check && pnpm run check:scripts",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/workspace-command.ts tests/e2e",
    "e2e:docker": "node scripts/e2e-docker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spa": "node scripts/workspace-command.ts src/hackathon-spa",
    "api-codegen": "node scripts/api-codegen.ts",
    "sqlfluff": "node scripts/sqlfluff.ts",
    "update-database-docs": "node scripts/update-database-docs.ts",
    "verify": "pnpm run build && pnpm run check && pnpm run lint && pnpm run spa test && pnpm run format:check"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint-react/eslint-plugin": "5.8.16",
    "@tanstack/eslint-plugin-query": "5.101.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "24.13.1",
    "@vitest/eslint-plugin": "1.6.19",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "65.0.1",
    "eslint-plugin-zod": "4.7.0",
    "jiti": "2.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "tinyexec": "1.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0"
  }
}
